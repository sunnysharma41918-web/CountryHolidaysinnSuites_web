# ==============================================================
# Country Holidays Inn & Suites - Backend Environment Configuration
# ==============================================================

# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Atlas Free Tier Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/chis_db?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication
JWT_SECRET=chis_super_secret_jwt_key_at_least_32_characters_long_replace_in_prod
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and reset-password links)
CLIENT_URL=http://localhost:5173

# Initial Admin Seeding (Used by 'npm run seed:admin')
ADMIN_SEED_EMAIL=admin@countryholidaysinnsuites.com
ADMIN_SEED_PASSWORD=Admin@CHIS2026!
ADMIN_SEED_NAME=Principal Administrator

# SMTP Email Configuration (Optional - dev fallback will log reset link to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Country Holidays Inn & Suites <noreply@countryholidaysinnsuites.com>
